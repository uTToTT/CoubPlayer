<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net5.0-windows7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>player_icon.ico</ApplicationIcon>
  </PropertyGroup>

  <!--
    В Release не публикуем отладочные символы: один только libSkiaSharp.pdb
    весит 84 МБ — почти половина портативной сборки — и в готовом приложении
    бесполезен. Свойства вроде AllowedReferenceRelatedFileExtensions сюда не
    достают: этот pdb приходит из пакета как нативный runtime-ресурс.
    На отладку в Debug это не влияет.
  -->
  <Target Name="DropSymbolsFromRelease" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Content Include="player_icon.ico" />
  </ItemGroup>

  <!--
    wwwroot/Data — библиотека пользователя: скачанные ролики, плейлисты, теги.
    Лежит внутри wwwroot, потому что раздаётся плеером как статика, но частью
    приложения не является: при публикации это утягивало бы сотни мегабайт
    чужих видео. Приложение создаёт эту папку само при первом запуске.
  -->
  <ItemGroup>
    <Content Remove="wwwroot\Data\**" />
    <None Remove="wwwroot\Data\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="SkiaSharp" Version="3.119.2" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.7" />
  </ItemGroup>

</Project>
